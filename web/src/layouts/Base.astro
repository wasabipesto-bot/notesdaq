---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Every reblog is an investment. How's your portfolio?" } = Astro.props;
const API_BASE = import.meta.env.PUBLIC_API_BASE || "http://localhost:3001/api/v1";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="nav">
    <a href="/" class="nav-logo">notesdaq</a>
    <form class="nav-search" action="/blog" method="get">
      <input type="text" name="q" placeholder="Look up a blog..." autocomplete="off" />
      <button type="submit">Go</button>
    </form>
    <div class="nav-links">
      <a href="/about">About</a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <p>notesdaq &mdash; a virtual stock market for Tumblr reblogs</p>
  </footer>

  <script define:vars={{ API_BASE }}>
    window.__API_BASE = API_BASE;
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0f;
    --bg-card: #12121a;
    --bg-hover: #1a1a26;
    --border: #2a2a3a;
    --text: #e0e0e8;
    --text-dim: #8888a0;
    --accent: #6c5ce7;
    --green: #00b894;
    --red: #e17055;
    --yellow: #fdcb6e;
    --font: 'Space Grotesk', system-ui, sans-serif;
    --mono: 'Space Mono', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { font-size: 16px; }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
  }

  .nav-logo {
    font-family: var(--mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.5px;
  }
  .nav-logo:hover { text-decoration: none; opacity: 0.85; }

  .nav-search {
    display: flex;
    flex: 1;
    max-width: 400px;
  }
  .nav-search input {
    flex: 1;
    padding: 0.4rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px 0 0 6px;
    color: var(--text);
    font-family: var(--font);
    font-size: 0.875rem;
    outline: none;
  }
  .nav-search input:focus { border-color: var(--accent); }
  .nav-search button {
    padding: 0.4rem 0.75rem;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0 6px 6px 0;
    color: white;
    font-family: var(--font);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .nav-links { margin-left: auto; }
  .nav-links a { color: var(--text-dim); font-size: 0.875rem; }

  footer {
    text-align: center;
    padding: 2rem;
    color: var(--text-dim);
    font-size: 0.8rem;
    border-top: 1px solid var(--border);
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
  }

  .stat-value {
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .gain { color: var(--green); }
  .loss { color: var(--red); }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  th {
    text-align: left;
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  tr:hover { background: var(--bg-hover); }

  .pill {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: var(--mono);
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .loading {
    text-align: center;
    padding: 3rem;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .nav { flex-wrap: wrap; gap: 0.75rem; }
    .nav-search { order: 3; max-width: 100%; }
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
