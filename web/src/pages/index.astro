---
import Base from "../layouts/Base.astro";
---

<Base title="notesdaq — the Tumblr stock market">
  <section class="hero">
    <h1>Every reblog is an investment.</h1>
    <p class="hero-sub">notesdaq tracks the Tumblr reblog economy. Look up any blog and see how their reblogs performed as stocks.</p>
    <form class="hero-search" action="/blog" method="get">
      <input type="text" name="q" placeholder="Enter a Tumblr blog name..." autofocus autocomplete="off" />
      <button type="submit">View Portfolio</button>
    </form>
  </section>

  <section class="stats-bar" id="stats-bar">
    <div class="loading deferred">Loading stats...</div>
  </section>

  <section class="ticker-section">
    <h2 class="section-title">Recent Trades</h2>
    <div id="ticker" class="ticker-wrap">
      <div class="loading deferred">Loading ticker...</div>
    </div>
  </section>
</Base>

<script>
  import { api, formatNumber, relativeTime } from "../lib/api";

  async function loadStats() {
    try {
      const stats = await api<any>("/stats");
      document.getElementById("stats-bar")!.innerHTML = `
        <div class="card-grid">
          <div class="card">
            <div class="stat-label">Investments Tracked</div>
            <div class="stat-value">${formatNumber(stats.total_reblog_events)}</div>
          </div>
          <div class="card">
            <div class="stat-label">Blogs Discovered</div>
            <div class="stat-value">${formatNumber(stats.total_blogs)}</div>
          </div>
          <div class="card">
            <div class="stat-label">Posts Analyzed</div>
            <div class="stat-value">${formatNumber(stats.posts_enumerated)}</div>
          </div>
          <div class="card">
            <div class="stat-label">Likes Recorded</div>
            <div class="stat-value">${formatNumber(stats.total_likes)}</div>
          </div>
        </div>
      `;
    } catch {
      document.getElementById("stats-bar")!.innerHTML =
        '<div class="card" style="text-align:center;color:var(--text-dim)">Stats unavailable</div>';
    }
  }

  async function loadTicker() {
    try {
      const events = await api<any[]>("/ticker?limit=20");
      const el = document.getElementById("ticker")!;
      if (events.length === 0) {
        el.innerHTML = '<div style="color:var(--text-dim);padding:1rem">No trades recorded yet.</div>';
        return;
      }
      // Shuffle for variety (Fisher-Yates)
      for (let i = events.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [events[i], events[j]] = [events[j], events[i]];
      }
      const items = events
        .filter((e: any) => e.op_slug && e.op_slug !== "unknown")
        .map((e: any) => `
          <div class="ticker-item">
            <a href="/blog/${e.investor_slug}" class="ticker-investor">${e.investor_slug}</a>
            <span class="ticker-verb">bought</span>
            <a href="/post/${e.post_id}" class="ticker-post">${e.op_slug}</a>
            <span class="ticker-verb">at</span>
            <span class="ticker-price">${formatNumber(e.buy_price)} reblogs</span>
          </div>
        `).join("");
      // Duplicate items for seamless infinite scroll
      el.innerHTML = `<div class="ticker-track">${items}${items}</div>`;
    } catch {
      document.getElementById("ticker")!.innerHTML =
        '<div style="color:var(--text-dim);padding:1rem">Ticker unavailable</div>';
    }
  }

  loadStats();
  loadTicker();
</script>

<style is:global>
  .hero {
    text-align: center;
    padding: 4rem 1rem 3rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, var(--accent), var(--green));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub {
    color: var(--text-dim);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.5;
  }
  .hero-search {
    display: flex;
    max-width: 480px;
    margin: 0 auto;
  }
  .hero-search input {
    flex: 1;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px 0 0 8px;
    color: var(--text);
    font-family: var(--font);
    font-size: 1rem;
    outline: none;
  }
  .hero-search input:focus { border-color: var(--accent); }
  .hero-search button {
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    border: none;
    border-radius: 0 8px 8px 0;
    color: white;
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .hero-search button:hover { opacity: 0.9; }

  .deferred { opacity: 0; animation: fade-in 0.3s ease 0.4s forwards; }
  @keyframes fade-in { to { opacity: 1; } }

  .stats-bar { margin-bottom: 2rem; }

  .ticker-section { margin-bottom: 2rem; }
  .ticker-wrap {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }
  .ticker-wrap::before,
  .ticker-wrap::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2rem;
    z-index: 1;
    pointer-events: none;
  }
  .ticker-wrap::before {
    left: 0;
    background: linear-gradient(to right, var(--bg-card), transparent);
  }
  .ticker-wrap::after {
    right: 0;
    background: linear-gradient(to left, var(--bg-card), transparent);
  }

  .ticker-track {
    display: flex;
    gap: 0;
    animation: ticker-scroll 90s linear infinite;
    width: max-content;
  }
  .ticker-track:hover { animation-play-state: paused; }

  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .ticker-item {
    padding: 0.6rem 1.25rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
    border-right: 1px solid var(--border);
  }
  .ticker-investor { font-weight: 600; }
  .ticker-verb { color: var(--text-dim); }
  .ticker-post { }
  .ticker-at { color: var(--text-dim); }
  .ticker-price {
    font-family: var(--mono);
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 1.75rem; }
    .hero-search { flex-direction: column; }
    .hero-search input { border-radius: 8px; margin-bottom: 0.5rem; }
    .hero-search button { border-radius: 8px; }
  }
</style>
